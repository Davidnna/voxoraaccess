# Neon PostgreSQL connection string (use the pooled connection string if provided by Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
VOXORA_SECRET_KEY=replace-with-a-long-random-secret
VOXORA_MAX_UPLOAD_MB=20
VOXORA_HTTPS=1
VOXORA_DEBUG=0
GROQ_API_KEY=replace-with-your-groq-api-key
