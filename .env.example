# Neon PostgreSQL connection string (use the pooled connection string if provided by Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
VOXORA_SECRET_KEY=replace-with-a-long-random-secret
VOXORA_MAX_UPLOAD_MB=20
VOXORA_HTTPS=1
VOXORA_DEBUG=0
GROQ_API_KEY=replace-with-your-groq-api-key
VOXORA_MAX_EXTRACTED_TEXT_CHARS=200000
VOXORA_MAX_DOCUMENT_PAGES=250
VOXORA_MAX_OCR_PAGES=6
VOXORA_OCR_LANG=eng
VOXORA_OCR_TIMEOUT_SECONDS=5
